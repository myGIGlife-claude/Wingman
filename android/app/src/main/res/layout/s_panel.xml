<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/p_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp" android:layout_marginBottom="10dp" android:background="@drawable/panel_go">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:id="@+id/p_label" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/dim" android:fontFamily="@font/jetbrains_mono_medium" android:includeFontPadding="false" android:letterSpacing="0.14" android:layout_width="0dp" android:layout_weight="1" android:maxLines="1"/>
<TextView android:id="@+id/p_chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/go" android:fontFamily="@font/jetbrains_mono_bold" android:includeFontPadding="false" android:letterSpacing="0.08" android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:maxLines="1" android:background="@drawable/chip_go"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:layout_marginTop="12dp">
<Chronometer android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="52dp" android:gravity="center" android:paddingLeft="16dp" android:paddingRight="16dp" android:textSize="30sp" android:textColor="@color/go" android:fontFamily="@font/jetbrains_mono_extrabold" android:includeFontPadding="false" android:letterSpacing="0.1" android:background="@drawable/flap_bg"/>
<TextView android:id="@+id/clock_text" android:layout_width="wrap_content" android:layout_height="52dp" android:gravity="center" android:paddingLeft="16dp" android:paddingRight="16dp" android:textSize="30sp" android:textColor="@color/dim" android:fontFamily="@font/jetbrains_mono_extrabold" android:includeFontPadding="false" android:letterSpacing="0.1" android:background="@drawable/flap_bg" android:visibility="gone"/>
</LinearLayout>
<TextView android:id="@+id/p_sub" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/paper" android:fontFamily="@font/jetbrains_mono_regular" android:includeFontPadding="false" android:layout_width="match_parent" android:gravity="center" android:layout_marginTop="10dp" android:maxLines="1" android:ellipsize="end"/>
<LinearLayout android:id="@+id/p_slack" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
<TextView android:id="@+id/p_sl" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="@color/dim" android:fontFamily="@font/jetbrains_mono_medium" android:includeFontPadding="false" android:letterSpacing="0.1" android:layout_width="0dp" android:layout_weight="1" android:maxLines="1"/>
<TextView android:id="@+id/p_sv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="@color/go" android:fontFamily="@font/jetbrains_mono_bold" android:includeFontPadding="false" android:letterSpacing="0.1" android:maxLines="1"/>
</LinearLayout><FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"><ProgressBar android:id="@+id/pb_go" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progressDrawable="@drawable/bar_go" android:visibility="gone"/><ProgressBar android:id="@+id/pb_amber" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progressDrawable="@drawable/bar_amber" android:visibility="gone"/><ProgressBar android:id="@+id/pb_yellow" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progressDrawable="@drawable/bar_yellow" android:visibility="gone"/><ProgressBar android:id="@+id/pb_stop" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progressDrawable="@drawable/bar_stop" android:visibility="gone"/></FrameLayout></LinearLayout>
<TextView android:id="@+id/p_note" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/dim" android:fontFamily="@font/jetbrains_mono_regular" android:includeFontPadding="false" android:layout_width="match_parent" android:layout_marginTop="10dp"/>
</LinearLayout>
