<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:layout_marginBottom="10dp" android:background="@drawable/card_bg">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:id="@+id/k_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/dim" android:fontFamily="monospace" android:includeFontPadding="false" android:letterSpacing="0.06" android:maxLines="1"/>
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="bottom" android:layout_marginTop="4dp">
<TextView android:id="@+id/k_qty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="26sp" android:textColor="@color/go" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" /><TextView android:id="@+id/k_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/dim" android:fontFamily="monospace" android:includeFontPadding="false" android:layout_marginLeft="6dp" android:layout_marginBottom="3dp"/></LinearLayout>
<TextView android:id="@+id/k_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/paper" android:fontFamily="monospace" android:includeFontPadding="false" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
<TextView android:id="@+id/k_rl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/dim" android:fontFamily="monospace" android:includeFontPadding="false" android:letterSpacing="0.06"/><TextView android:id="@+id/k_rv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="26sp" android:textColor="@color/amber" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" android:layout_marginTop="4dp"/><Chronometer android:id="@+id/k_rt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="22sp" android:textColor="@color/amber" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" android:visibility="gone"/><TextView android:id="@+id/k_rs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/paper" android:fontFamily="monospace" android:includeFontPadding="false" android:layout_marginTop="4dp"/>
</LinearLayout></LinearLayout>
