<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="14dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:id="@+id/tgt_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/dim" android:fontFamily="monospace" android:letterSpacing="0.08" android:includeFontPadding="false"/>
<TextView android:id="@+id/tgt_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="22sp" android:textColor="@color/paper" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1"/>
</LinearLayout>
<TextView android:id="@+id/tgt_chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/amber" android:fontFamily="monospace" android:textStyle="bold" android:letterSpacing="0.06" android:includeFontPadding="false" android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:background="@drawable/chip_amber"/>
</LinearLayout>
<LinearLayout android:id="@+id/tgt_status_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginRight="12dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="5dp">
<TextView android:id="@+id/tgt_en_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="ENERGY" android:textSize="11sp" android:textColor="@color/dim" android:fontFamily="monospace" android:letterSpacing="0.06" android:includeFontPadding="false"/>
<TextView android:id="@+id/tgt_en_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/paper" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false"/>
</LinearLayout>
<ProgressBar android:id="@+id/tgt_en_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progressDrawable="@drawable/bar_amber"/>
</LinearLayout>
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:background="@drawable/chip_go" android:id="@+id/tgt_hosp_box">
<TextView android:id="@+id/tgt_hosp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/go" android:fontFamily="monospace" android:textStyle="bold" android:letterSpacing="0.04" android:includeFontPadding="false"/>
<Chronometer android:id="@+id/tgt_hosp_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="6dp" android:textSize="11sp" android:textColor="@color/stop" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" android:visibility="gone"/>
</LinearLayout>
</LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<ListView android:id="@+id/tgt_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="0dp" android:scrollbars="none" android:cacheColorHint="#00000000"/>
<TextView android:id="@+id/tgt_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textSize="13sp" android:textColor="@color/dim" android:fontFamily="monospace" android:padding="16dp"/>
</FrameLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:showDividers="middle" android:divider="@drawable/div8">
<TextView android:id="@+id/tgt_refresh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:gravity="center" android:text="⟳  REFRESH" android:textSize="13sp" android:fontFamily="monospace" android:textStyle="bold" android:letterSpacing="0.08" android:textColor="@color/dim" android:background="@drawable/btn_ghost"/>
</LinearLayout>
<TextView android:id="@+id/tgt_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="end" android:textSize="10sp" android:textColor="@color/dim" android:fontFamily="monospace" android:letterSpacing="0.06" android:includeFontPadding="false"/>
</LinearLayout>
