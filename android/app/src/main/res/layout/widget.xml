<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="12dp">

    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/dim" android:textSize="11sp" android:letterSpacing="0.12"
        android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end" />

    <Chronometer android:id="@+id/countdown" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center_vertical" android:textColor="@color/amber"
        android:textSize="34sp" android:fontFamily="monospace" android:textStyle="bold" />

    <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/paper" android:textSize="12sp" android:fontFamily="monospace"
        android:maxLines="2" android:ellipsize="end" android:paddingBottom="8dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/primary" android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:gravity="center" android:textSize="15sp" android:textStyle="bold"
            android:fontFamily="monospace" android:letterSpacing="0.1" android:background="@drawable/btn_amber" />
        <TextView android:id="@+id/bought" android:layout_width="wrap_content" android:layout_height="44dp"
            android:layout_marginStart="6dp" android:gravity="center" android:paddingHorizontal="12dp"
            android:text="BOUGHT ✓" android:textColor="@color/go" android:textSize="12sp" android:fontFamily="monospace"
            android:background="@drawable/btn_ghost" />
        <TextView android:id="@+id/refresh" android:layout_width="44dp" android:layout_height="44dp"
            android:layout_marginStart="6dp" android:gravity="center" android:text="⟳" android:textColor="@color/dim"
            android:textSize="18sp" android:background="@drawable/btn_ghost" />
    </LinearLayout>
</LinearLayout>
