<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:padding="12dp" android:background="@drawable/card_bg">
<TextView android:id="@+id/t_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="@color/dim" android:fontFamily="monospace" android:includeFontPadding="false" android:letterSpacing="0.12" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/t_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" android:textColor="@color/paper" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1" android:layout_marginTop="4dp"/>
<Chronometer android:id="@+id/t_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" android:layout_marginTop="4dp"/>
<TextView android:id="@+id/t_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/paper" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp"/></LinearLayout>
