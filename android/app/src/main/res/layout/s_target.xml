<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/tg_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_marginBottom="8dp" android:background="@drawable/card_bg">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:id="@+id/tg_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="@color/paper" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/tg_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="12sp" android:textColor="@color/dim" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1"/>
</LinearLayout>
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
<TextView android:id="@+id/tg_pill" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/go" android:fontFamily="monospace" android:textStyle="bold" android:letterSpacing="0.06" android:includeFontPadding="false" android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:background="@drawable/chip_go"/>
<Chronometer android:id="@+id/tg_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="14sp" android:textColor="@color/amber" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" android:visibility="gone"/>
</LinearLayout></LinearLayout>
