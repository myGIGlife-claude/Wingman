<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:id="@+id/h_faction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/dim" android:fontFamily="monospace" android:includeFontPadding="false" android:letterSpacing="0.06" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/h_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" android:textColor="@color/paper" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp"/>
</LinearLayout>
<TextView android:id="@+id/h_chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/amber" android:fontFamily="monospace" android:textStyle="bold" android:includeFontPadding="false" android:letterSpacing="0.08" android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:maxLines="1"/>
</LinearLayout>
